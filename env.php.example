<?php
/**
 * ============================================================
 *  Seguros Lux CRM — Configuración de entorno
 * ============================================================
 *
 *  INSTRUCCIONES:
 *    1. Copia este archivo a la raíz del proyecto como .env.php:
 *           cp env.php.example .env.php
 *    2. Rellena cada variable con los valores reales.
 *    3. Nunca versiones .env.php — está en .gitignore.
 *
 *  FORMATO:
 *    Usa putenv('CLAVE=valor'). Este es un archivo PHP válido,
 *    NO formato dotenv (KEY=valor sin PHP). Si el contenido
 *    no es PHP válido, se mostrará como texto en el HTML.
 *
 *  ÁMBITOS:
 *    [BD]        Base de datos MySQL/MariaDB
 *    [SMTP]      Correo saliente
 *    [REDIS]     Rate limiter (opcional — cae a fichero si no está)
 *    [STORAGE]   iDrive / S3 para pólizas y documentos
 *    [TELEGRAM]  Bot de Telegram para recordatorios y gestión de citas
 *    [WHATSAPP]  API de WhatsApp Business
 *    [APP]       Comportamiento general de la aplicación
 *    [SEGURIDAD] Tokens de acceso a endpoints protegidos
 * ============================================================
 */

// ── [BD] Base de datos ────────────────────────────────────────────────────────
putenv('DB_HOST=localhost');            // Host de MySQL. Normalmente "localhost".
putenv('DB_USER=tu_usuario_db');       // Usuario con permisos sobre la BD del CRM.
putenv('DB_PASS=tu_contrasena_db');    // Contraseña del usuario de BD.
putenv('DB_NAME=grupoide_seguroslux'); // Nombre de la base de datos.

// ── [SMTP] Correo saliente ────────────────────────────────────────────────────
putenv('SMTP_HOST=mail.seguroslux.mx');        // Servidor SMTP (ej. Hostgator, Gmail, Brevo).
putenv('SMTP_USER=contacto@seguroslux.mx');    // Cuenta de correo para autenticación.
putenv('SMTP_PASS=tu_contrasena_smtp');        // Contraseña SMTP — NO la del correo web.
putenv('SMTP_PORT=465');                        // 465 = SMTPS, 587 = STARTTLS.
putenv('SMTP_FROM=contacto@seguroslux.mx');    // Dirección From de los correos enviados.
putenv('SMTP_FROM_NAME=Seguros LUX');          // Nombre visible en el campo From.

// ── [REDIS] Rate limiter (opcional) ──────────────────────────────────────────
// Si Redis no está disponible, RateLimiter cae a almacenamiento en fichero.
putenv('REDIS_HOST=127.0.0.1');   // IP o hostname del servidor Redis.
putenv('REDIS_PORT=6379');        // Puerto estándar de Redis.
putenv('REDIS_PASSWORD=');        // Contraseña de Redis (dejar vacío si no hay auth).

// ── [STORAGE] iDrive E2 / S3 compatible ──────────────────────────────────────
// Usado para subir pólizas, comprobantes y documentos del cliente.
putenv('IDRIVE_KEY_ID=tu_access_key_id');          // Access Key ID de iDrive E2.
putenv('IDRIVE_KEY_SECRET=tu_secret_access_key');  // Secret Access Key de iDrive E2.
putenv('IDRIVE_BUCKET=tu_bucket');                 // Nombre del bucket donde se guardan los archivos.
putenv('IDRIVE_ENDPOINT=https://s3.us-east-1.idrivecompute.com'); // Endpoint S3 de tu región iDrive.

// ── [TELEGRAM] Bot ────────────────────────────────────────────────────────────
// Crea tu bot con @BotFather en Telegram para obtener el token.
putenv('TELEGRAM_BOT_TOKEN=tu_bot_token_aqui'); // Token del bot (formato: 123456:ABC-DEF...).

// Webhook: URL pública que Telegram llamará para enviar mensajes al bot.
// Debe ser HTTPS. Regístrala con: php public/register_webhook.php
putenv('TELEGRAM_WEBHOOK_URL=https://tudominio.com/telegram/webhook');

// ── [WHATSAPP] API Business ───────────────────────────────────────────────────
putenv('WA_PHONE_ID=tu_phone_number_id');     // Phone Number ID de Meta for Developers.
putenv('WA_TOKEN=tu_access_token');           // Token de acceso permanente de la app de Meta.
putenv('WA_VERIFY_TOKEN=tu_verify_token');    // Token de verificación del webhook (lo defines tú).
putenv('WA_WEBHOOK_URL=https://tudominio.com/whatsapp/webhook'); // URL del webhook.

// ── [APP] Comportamiento general ──────────────────────────────────────────────
putenv('APP_ENV=production');     // 'production' | 'development'. Activa HTTPS forzado en production.
putenv('APP_URL=https://tudominio.com'); // URL base de la aplicación (sin barra final).

// Prefijo de assets CSS/JS si el DocumentRoot NO apunta a public/.
// Ejemplo: si tus assets son accesibles en https://tudominio.com/public/js/...
//   putenv('ASSET_PREFIX=/public');
// Si el DocumentRoot ya apunta a public/, déjalo vacío.
putenv('ASSET_PREFIX=');

// CORS: orígenes permitidos para la API de horas ocupadas (separados por coma).
// NUNCA uses '*' en producción.
putenv('CORS_ALLOWED_ORIGINS=https://tudominio.com');

// ── [SEGURIDAD] Tokens de endpoints protegidos ────────────────────────────────
// GET /api/health?deep=1&token=<HEALTH_CHECK_TOKEN>
// Genera un token seguro con: php -r "echo bin2hex(random_bytes(32));"
putenv('HEALTH_CHECK_TOKEN=genera_un_token_seguro_aqui');

// Activar log de debug del webhook (solo en desarrollo; evita en producción).
// 1 = activo, 0 = inactivo.
putenv('WEBHOOK_DEBUG_LOG=0');

// Correo del asesor principal que recibe notificaciones del formulario público.
// Si tienes múltiples asesores, la asignación automática se gestiona desde la BD.
putenv('ASESOR_EMAIL=asesor@tudominio.com');
