{
    "name": "seguroslux/crm",
    "description": "CRM Seguros LUX — aplicación PHP",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.300",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "Database\\": "Database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
