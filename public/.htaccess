Options -Indexes
RewriteEngine On

# ── Redirigir HTTP → HTTPS en producción ──────────────────────────────────────
# Descomenta estas líneas cuando tengas SSL activo:
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Webhooks de bots: rutas directas, sin pasar por index.php ─────────────────
# Telegram: https://seguroslux.mx/telegram/webhook
RewriteRule ^telegram/webhook/?$ telegram/telegram_webhook.php [L]

# WhatsApp: https://seguroslux.mx/whatsapp/webhook
RewriteRule ^whatsapp/webhook/?$ whatsapp/whatsapp_webhook.php [L]

# ── Bloquear acceso directo a archivos PHP ────────────────────────────────────
#
# ORDEN IMPORTANTE: esto va ANTES de servir archivos reales.
#
# Antes estaba al final, después de una regla «si el archivo existe, sírvelo»
# que lleva [L]. [L] detiene el procesamiento, así que cualquier .php existente
# se servía y esta regla no llegaba a evaluarse nunca: estaba escrita, pero no
# protegía nada. Por eso quedaban alcanzables utilidades sueltas del directorio
# público.
#
# Las excepciones son las únicas entradas legítimas que no pasan por el
# front-controller: los webhooks (los llama un tercero con su propia URL) y
# dos utilidades que, además, se protegen por su cuenta en PHP.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} !^/blog/
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteCond %{REQUEST_URI} !^/SessionPing\.php$
    RewriteCond %{REQUEST_URI} !^/telegram/telegram_webhook\.php$
    RewriteCond %{REQUEST_URI} !^/whatsapp/whatsapp_webhook\.php$
    RewriteCond %{REQUEST_URI} !^/meta/meta_webhook\.php$
    RewriteCond %{REQUEST_URI} !^/diagnostico\.php$
    RewriteCond %{REQUEST_URI} !^/register_webhook\.php$
    RewriteRule \.php$ - [F,L]
</IfModule>

# ── Servir archivos y directorios reales ──────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── Front controller ──────────────────────────────────────────────────────────
RewriteRule ^ index.php [QSA,L]

# ── Bloquear acceso directo a archivos sensibles ──────────────────────────────

# Configuración y entorno
<Files ".env.php">
    Require all denied
</Files>
<Files ".env">
    Require all denied
</Files>
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>

# Logs de seguridad — nunca deben ser públicos
<IfModule mod_rewrite.c>
    RewriteRule ^logs/         - [F,L]
    RewriteRule ^storage/      - [F,L]
</IfModule>

# Bloquear archivos de configuración y backup comunes
<FilesMatch "\.(sql|bak|log|sh|env|ini|phar|git)$">
    Require all denied
</FilesMatch>

# ── Cabeceras de seguridad adicionales vía Apache ─────────────────────────────
# (como respaldo a las que emite PHP; si usas nginx, muévelas al server block)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Activar HSTS solo cuando HTTPS esté confirmado y estable:
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Proteger directorios sensibles ────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteRule ^Core/          - [F,L]
    RewriteRule ^App/           - [F,L]
</IfModule>
